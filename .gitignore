# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# H5P library substrate is committed (Vercel needs it, and data/*.h5p sources
# aren't in the repo). Only the per-item runtime render output is ignored.
/public/h5p/_render/

# review-stage eval log (MVP)
/.review-events.jsonl

# persisted import records (MVP)
/.imports.jsonl

# product/UX artifact pages — published as Claude artifacts, kept out of the app repo
/docs/*.html
